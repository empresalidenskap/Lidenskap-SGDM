        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam dpi 160\nskinparam shadowing false\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 13\nskinparam ArrowColor #37474F\nskinparam actor {\n  BackgroundColor #ECEFF1\n  BorderColor #37474F\n}\nskinparam usecase {\n  BackgroundColor #E8F0FE\n  BorderColor #3F5B8B\n  FontColor #1A237E\n}\nskinparam rectangle {\n  BorderColor #37474F\n  BackgroundColor #FCFCFC\n}\nskinparam package {\n  BorderColor #90A4AE\n  BackgroundColor #F7F9FA\n  FontColor #37474F\n  FontStyle bold\n}\nleft to right direction\n\n\nactor \&quot;Administrador General\\n(ROL-01)\&quot; as ADM\nactor \&quot;Organizador de Torneo\\n(ROL-02)\&quot; as ORG\nADM --|&gt; ORG\n\nrectangle \&quot;SGDM — Módulo de Administración del Sistema\&quot; {\n  package \&quot;Administración del Sistema\&quot; {\n    usecase \&quot;CU-21\\nGestionar usuarios\\nadministrativos\&quot; as U21\n    usecase \&quot;CU-22\\nHabilitar o deshabilitar\\nmódulos del sistema\&quot; as U22\n    usecase \&quot;CU-23\\nReabrir fase o ronda cerrada\&quot; as U23\n    usecase \&quot;CU-24\\nRegistrar y consultar\\nlog de auditoría\&quot; as U24\n    usecase \&quot;CU-25\\nConsultar reportes y\\nestadísticas generales\&quot; as U25\n    usecase \&quot;CU-32\\nAsignar torneo a un\\nOrganizador\&quot; as U32\n  }\n}\n\nADM --&gt; U21\nADM --&gt; U22\nADM --&gt; U23\nADM --&gt; U24\nADM --&gt; U25\nADM --&gt; U32\nORG --&gt; U25\n\nU21 ..&gt; U32 : &lt;&lt;include&gt;&gt;\nU23 ..&gt; U24 : &lt;&lt;include&gt;&gt;\n\nnote bottom of U23\n  RF-13: solo el ROL-01 puede reabrir;\n  se registra usuario, fecha y motivo\nend note\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rOIvD6cN2JFm6FQDV5Oj-129">
