        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam dpi 160\nskinparam shadowing false\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 13\nskinparam ArrowColor #37474F\nskinparam actor {\n  BackgroundColor #ECEFF1\n  BorderColor #37474F\n}\nskinparam usecase {\n  BackgroundColor #E8F0FE\n  BorderColor #3F5B8B\n  FontColor #1A237E\n}\nskinparam rectangle {\n  BorderColor #37474F\n  BackgroundColor #FCFCFC\n}\nskinparam package {\n  BorderColor #90A4AE\n  BackgroundColor #F7F9FA\n  FontColor #37474F\n  FontStyle bold\n}\nleft to right direction\n\n\nactor \&quot;Usuario Público\\n(ROL-04)\&quot; as PUB\nactor \&quot;Participante\\n(ROL-03)\&quot; as PART\nPART --|&gt; PUB\n\nrectangle \&quot;SGDM — Módulos de Consulta Pública, Autenticación y Perfil\&quot; {\n  package \&quot;Consulta Pública\&quot; {\n    usecase \&quot;CU-01\\nConsultar torneos publicados\&quot; as U01\n    usecase \&quot;CU-02\\nConsultar calendario de\\nenfrentamientos\&quot; as U02\n    usecase \&quot;CU-03\\nConsultar tabla de posiciones\&quot; as U03\n    usecase \&quot;CU-04\\nConsultar llaves (brackets)\&quot; as U04\n    usecase \&quot;CU-05\\nConsultar perfil público de\\nparticipante o equipo\&quot; as U05\n  }\n  package \&quot;Autenticación y Perfil\&quot; {\n    usecase \&quot;CU-06\\nIniciar sesión\&quot; as U06\n    usecase \&quot;CU-07\\nEditar datos del perfil propio\&quot; as U07\n    usecase \&quot;CU-08\\nConsultar histórico\\nestadístico propio\&quot; as U08\n    usecase \&quot;CU-31\\nValidar credenciales\\ny nivel de acceso\&quot; as U31\n  }\n}\n\nPUB --&gt; U01\nPUB --&gt; U02\nPUB --&gt; U03\nPUB --&gt; U04\nPUB --&gt; U05\nPART --&gt; U06\nPART --&gt; U07\nPART --&gt; U08\n\nU06 ..&gt; U31 : &lt;&lt;include&gt;&gt;\nU07 ..&gt; U31 : &lt;&lt;include&gt;&gt;\nU08 ..&gt; U31 : &lt;&lt;include&gt;&gt;\n\nnote bottom of U03\n  RNF-04: la tabla de posiciones es el\n  pr