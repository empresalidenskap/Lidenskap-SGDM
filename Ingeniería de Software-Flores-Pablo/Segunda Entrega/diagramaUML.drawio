        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam dpi 160\nskinparam shadowing false\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 12\nskinparam ArrowColor #37474F\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #3F5B8B\n  HeaderBackgroundColor #E8F0FE\n  FontColor #1A237E\n  AttributeFontColor #263238\n}\nhide circle\nskinparam classAttributeIconSize 0\n\nclass Usuario {\n   idUsuario : int\n   nombreUsuario : String\n   email : String\n   hashContrasena : String\n   rol : RolEnum\n   nivelAcceso : int\n   activo : boolean\n   fechaAlta : Date\n  --\n   iniciarSesion(email, contrasena) : boolean\n   cerrarSesion() : void\n   editarPerfil(datos : Map) : void\n   tienePermiso(accion : String, recurso : Object) : boolean\n   cambiarContrasena(actual, nueva) : boolean\n}\n\nclass Torneo {\n   idTorneo : int\n   nombre : String\n   disciplina : String\n   formato : FormatoEnum\n   fechaInicio : Date\n   fechaFin : Date\n   cupoMaximo : int\n   estado : EstadoTorneoEnum\n   marcadorWalkover : String\n   rondaActual : int\n  --\n   abrirInscripciones() : void\n   cerrarInscripciones() : void\n   generarCalendario() : List&lt;Enfrentamiento&gt;\n   publicarRonda(nro : int) : void\n   cerrarRonda(nro : int) : void\n   reabrirRonda(nro : int, motivo : String) : boolean\n   calcularTablaPosiciones() : List&lt;Participante&gt;\n   estaCerrada(nro : int) : boolean\n}\n\nclass Participante {\n   idParticipante : int\n   nombre : String\n   tipo : TipoParticipanteEnum\n   estadoInscripcion : EstadoInscripcionEnum\n   puntosAcumulados : int\n   partidosJugados : int\n   diferenciaMarcador : int\n   seed : int\n  --\n   inscribirse(t : Torneo) : void\n   validarInscripcion() : void\n   consultarCalendario() : List&lt;Enfrentamiento&gt;\n   consultarPosicion(t : Torneo) : int\n   obtenerHistorialRivales(t : Torneo) : List&lt;Participante&gt;\n   yaEnfrento(rival : Participante) : boolean\n}\n\nclass Enfrentamiento {\n   idEnfrentamiento : int\n   numeroRonda : int\n   fechaHora : DateTime\n   locacion : String\n   estado : EstadoEnfrentamientoEnum\n  --\n   programar(fechaHora : DateTime, locacion : String) : void\n   reprogramar(fechaHora : DateTime, locacion : String) : void\n   registrarResultado(r : Resultado) : void\n   obtenerGanador() : Participante\n   estaFinalizado() : boolean\n}\n\nclass Resultado {\n   idResultado : int\n   marcadorLocal : int\n   marcadorVisitante : int\n   tipoCierre : TipoCierreEnum\n   validado : boolean\n   fechaRegistro : DateTime\n  --\n   registrar(local : int, visitante : int) : void\n   corregir(local : int, visitante : int, motivo : String) : boolean\n   determinarGanador() : Participante\n   esWalkover() : boolean\n}\n\nUsuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Torneo : organiza &gt;\nUsuario \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Participante : representa a &gt;\nUsuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Resultado : registra &gt;\n\nTorneo \&quot;1\&quot; o-- \&quot;2..*\&quot; Participante : inscribe &gt;\nTorneo \&quot;1\&quot; *-- \&quot;0..*\&quot; Enfrentamiento : contiene &gt;\n\nEnfrentamiento \&quot;0..*\&quot; --&gt; \&quot;2\&quot; Participante : enfrenta &gt;\nEnfrentamiento \&quot;1\&quot; *-- \&quot;0..1\&quot; Resultado : produce &gt;\n\nnote right of Torneo\n  formato ∈ {LIGA,\n  ELIMINACION_DIRECTA, SUIZO}\n  estado ∈ {CREADO,\n  INSCRIPCION_ABIERTA,\n  INSCRIPCION_CERRADA,\n  EN_CURSO, FINALIZADO}\nend note\n\nnote bottom of Resultado\n  tipoCierre ∈ {NORMAL, WALKOVER}\n  RF-12: un WO se persiste\n  diferenciado de un partido jugado\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rOIvD6cN2JFm6FQDV5Oj-155">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=1;groupPadding=10;fillColor=none;labelBackgroundColor=none;rounded=0;fontFamily=Times New Roman;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
