        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam dpi 160\nskinparam shadowing false\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 13\nskinparam ArrowColor #37474F\nskinparam actor {\n  BackgroundColor #ECEFF1\n  BorderColor #37474F\n}\nskinparam usecase {\n  BackgroundColor #E8F0FE\n  BorderColor #3F5B8B\n  FontColor #1A237E\n}\nskinparam rectangle {\n  BorderColor #37474F\n  BackgroundColor #FCFCFC\n}\nskinparam package {\n  BorderColor #90A4AE\n  BackgroundColor #F7F9FA\n  FontColor #37474F\n  FontStyle bold\n}\nleft to right direction\n\n\nactor \&quot;Organizador de Torneo\\n(ROL-02)\&quot; as ORG\nactor \&quot;Árbitro\\n(ROL-05)\&quot; as ARB\nactor \&quot;Administrador General\\n(ROL-01)\&quot; as ADM\nADM --|&gt; ORG\n\nrectangle \&quot;SGDM — Módulos de Gestión de Torneos y Resultados\&quot; {\n  package \&quot;Gestión de Torneos\&quot; {\n    usecase \&quot;CU-09\\nCrear torneo\&quot; as U09\n    usecase \&quot;CU-10\\nConfigurar formato y\\nreglas del torneo\&quot; as U10\n    usecase \&quot;CU-11\\nAbrir inscripciones\&quot; as U11\n    usecase \&quot;CU-12\\nValidar inscripción de\\nparticipante o equipo\&quot; as U12\n    usecase \&quot;CU-13\\nCerrar plazo de inscripción\&quot; as U13\n    usecase \&quot;CU-14\\nGenerar calendario\\ndel torneo\&quot; as U14\n    usecase \&quot;CU-15\\nPublicar ronda\&quot; as U15\n    usecase \&quot;CU-16\\nCerrar ronda\&quot; as U16\n    usecase \&quot;CU-17\\nModificar horario o locación\\nde un enfrentamiento\&quot; as U17\n    usecase \&quot;CU-26\\nNotificar cambio a los\\nusuarios involucrados\&quot; as U26\n  }\n  package \&quot;Resultados\&quot; {\n    usecase \&quot;CU-18\\nRegistrar resultado de\\nenfrentamiento\&quot; as U18\n    usecase \&quot;CU-19\\nCorregir resultado cargado\&quot; as U19\n    usecase \&quot;CU-20\\nRecalcular tabla de\\nposiciones\&quot; as U20\n    usecase \&quot;CU-29\\nRegistrar Walkover (WO)\&quot; as U29\n  }\n}\n\nORG --&gt; U09\nORG --&gt; U11\nORG --&gt; U12\nORG --&gt; U13\nORG --&gt; U14\nORG --&gt; U15\nORG --&gt; U16\nORG --&gt; U17\nORG --&gt; U18\nORG --&gt; U19\nARB --&gt; U18\nARB --&gt; U19\nADM --&gt; U18\n\nU09 ..&gt; U10 : &lt;&lt;include&gt;&gt;\nU18 ..&gt; U20 : &lt;&lt;include&gt;&gt;\nU19 ..&gt; U20 : &lt;&lt;include&gt;&gt;\nU26 .&gt; U17 : &lt;&lt;extend&gt;&gt;\nU29 .&gt; U18 : &lt;&lt;extend&gt;&gt;\n\nnote bottom of U19\n  RF-11: el Árbitro pierde el permiso\n  de Actualización cuando el\n  Organizador cierra la ronda\nend note\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rOIvD6cN2JFm6FQDV5Oj-83">
