# Plantilla de variables. En el servidor, docker_sgdm.sh genera /opt/sgdm/docker/.env
# con contraseñas aleatorias (solo root puede leerlo).
DB_NAME=sgdm
DB_ROOT_PASSWORD=changeme
DB_ADMIN_USER=sgdm_admin
DB_ADMIN_PASSWORD=changeme
DB_APP_USER=sgdm_app
DB_APP_PASSWORD=changeme
DB_CONSULTA_USER=sgdm_consulta
DB_CONSULTA_PASSWORD=changeme
